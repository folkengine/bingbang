#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v pandoc >/dev/null 2>&1; then
  echo "error: pandoc is not installed (https://pandoc.org/installing.html)" >&2
  exit 1
fi

files=()
while IFS= read -r f; do
  files+=("$f")
done < <(
  find . \
    \( -path ./.git -o -path ./node_modules -o -path ./dist -o -path ./build \) -prune -o \
    -type f -name '*.md' -print \
  | sed 's|^\./||' \
  | sort
)

if [ "${#files[@]}" -eq 0 ]; then
  echo "error: no markdown files found under $repo_root" >&2
  exit 1
fi

title="$(grep -m1 -E '^# ' README.md 2>/dev/null | sed -E 's/^# //')"
if [ -z "$title" ]; then
  title="$(basename "$repo_root")"
fi

author="$(git log -1 --pretty=format:'%an' 2>/dev/null)"
if [ -z "$author" ]; then
  author="Unknown"
fi

out="book.epub"

pandoc "${files[@]}" \
  --metadata title="$title" \
  --metadata author="$author" \
  --toc \
  -o "$out"

echo "Wrote $repo_root/$out"
